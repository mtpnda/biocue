rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    match /pairings/{pairingId} {
      allow read: if request.auth != null && (
        resource.data.wearerUid == request.auth.uid || 
        resource.data.caregiverUid == request.auth.uid
      );
      allow create: if request.auth != null && request.resource.data.caregiverUid == request.auth.uid;
      allow update: if request.auth != null && resource.data.wearerUid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.wearerUid == request.auth.uid;
    }
    match /active_codes/{codeId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /wearerData/{wearerUid}/{document=**} {
      allow write: if request.auth != null && request.auth.uid == wearerUid;
      allow read: if request.auth != null && (
        request.auth.uid == wearerUid || 
        (
          exists(/databases/$(database)/documents/pairings/$(wearerUid + "_" + request.auth.uid)) &&
          get(/databases/$(database)/documents/pairings/$(wearerUid + "_" + request.auth.uid)).data.status == "APPROVED"
        )
      );
    }
  }
}
