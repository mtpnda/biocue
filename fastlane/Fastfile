# ==============================================================================
# BioCue Fastlane Release Pipeline
# Multiplatform Release Automation for macOS, iOS, and Android
# Supports:
#   • Internal Release (Direct output to custom folder / centralized webhost)
#   • External Release (GitHub Releases, DMG/APK distribution, TestFlight External)
#   • App Store Release (Apple App Store & Mac App Store via App Store Connect)
#   • Play Store Release (Google Play Console Production / Staged Rollout)
# ==============================================================================

opt_out_usage

default_platform(:mac)

def root_dir
  File.expand_path("..", __dir__)
end

def dest_dir
  ENV["OUTPUT_DIR"] || ENV["MAC_WEBHOST_DIR"] || "/Users/valdiearsanur/Workspace/macbook-air-webhost"
end

def app_name
  ENV["APP_NAME"] || "BioCue"
end

def app_version
  if ENV["VERSION_NAME"] && !ENV["VERSION_NAME"].empty?
    return ENV["VERSION_NAME"].strip
  end
  gradle_props = File.join(root_dir, "android/gradle.properties")
  if File.exist?(gradle_props)
    match = File.read(gradle_props).match(/biocue\.versionName\s*=\s*(.+)/)
    return match[1].strip if match
  end
  "0.1.6"
end

def resolve_play_json
  candidates = [
    ENV["SUPPLY_JSON_KEY"],
    (ENV["SUPPLY_JSON_KEY"] ? File.join(root_dir, ENV["SUPPLY_JSON_KEY"]) : nil),
    File.join(root_dir, "android/play-account.json"),
    File.join(root_dir, "play-account.json"),
    File.join(root_dir, ".secrets/android/play-account.json"),
    File.expand_path("~/.secrets/android/play-account.json"),
    File.expand_path("~/.secrets/play-account.json")
  ].compact.reject(&:empty?)

  candidates.find { |p| File.exist?(p) } || File.join(root_dir, "android/play-account.json")
end

def xcode_project
  ENV["XCODE_PROJECT"] || ""
end

def asc_api_key
  return nil unless ENV["APP_STORE_CONNECT_KEY_ID"] && ENV["APP_STORE_CONNECT_ISSUER_ID"]
  app_store_connect_api_key(
    key_id:                ENV["APP_STORE_CONNECT_KEY_ID"],
    issuer_id:             ENV["APP_STORE_CONNECT_ISSUER_ID"],
    key_content:           ENV["APP_STORE_CONNECT_KEY_CONTENT"],
    is_key_content_base64: true
  )
end

# Helper to safely copy build artifacts to destination folder without mutating configs
def copy_build_file(src, dest_subfolder = "")
  return unless File.exist?(src)
  target_dir = dest_subfolder.empty? ? dest_dir : File.join(dest_dir, dest_subfolder)
  FileUtils.mkdir_p(target_dir)
  FileUtils.cp(src, target_dir)
  UI.message("✓ Exported #{File.basename(src)} -> #{target_dir}")
end

def copy_artifacts_to_folder(dest_folder)
  FileUtils.mkdir_p(dest_folder)
  downloads_subfolder = File.join(dest_folder, "downloads")
  FileUtils.mkdir_p(downloads_subfolder)

  # Android Companion (:mobile) APK & AAB
  mobile_apk = Dir[
    File.join(root_dir, "android/mobile/build/outputs/apk/release/*.apk"),
    File.join(root_dir, "android/mobile/build/outputs/apk/debug/*.apk"),
    File.join(root_dir, "mobile/build/outputs/apk/release/*.apk"),
    File.join(root_dir, "mobile/build/outputs/apk/debug/*.apk")
  ].find { |f| File.exist?(f) }

  mobile_aab = Dir[
    File.join(root_dir, "android/mobile/build/outputs/bundle/release/*.aab"),
    File.join(root_dir, "android/mobile/build/outputs/bundle/debug/*.aab"),
    File.join(root_dir, "mobile/build/outputs/bundle/release/*.aab"),
    File.join(root_dir, "mobile/build/outputs/bundle/debug/*.aab")
  ].find { |f| File.exist?(f) }

  # Wear OS (:wear) APK & AAB
  wear_apk = Dir[
    File.join(root_dir, "android/wear/build/outputs/apk/release/*.apk"),
    File.join(root_dir, "android/wear/build/outputs/apk/debug/*.apk"),
    File.join(root_dir, "wear/build/outputs/apk/release/*.apk"),
    File.join(root_dir, "wear/build/outputs/apk/debug/*.apk")
  ].find { |f| File.exist?(f) }

  wear_aab = Dir[
    File.join(root_dir, "android/wear/build/outputs/bundle/release/*.aab"),
    File.join(root_dir, "android/wear/build/outputs/bundle/debug/*.aab"),
    File.join(root_dir, "wear/build/outputs/bundle/release/*.aab"),
    File.join(root_dir, "wear/build/outputs/bundle/debug/*.aab")
  ].find { |f| File.exist?(f) }

  if mobile_apk
    FileUtils.cp(mobile_apk, File.join(dest_folder, "BioCue-Mobile.apk"))
    FileUtils.cp(mobile_apk, File.join(downloads_subfolder, "BioCue-Mobile.apk"))
    FileUtils.cp(mobile_apk, File.join(dest_folder, "BioCue.apk"))
    FileUtils.cp(mobile_apk, File.join(downloads_subfolder, "BioCue.apk"))
    UI.message("✓ Copied Mobile APK to: #{downloads_subfolder}/BioCue-Mobile.apk")
  end

  if mobile_aab
    FileUtils.cp(mobile_aab, File.join(dest_folder, "BioCue-Mobile.aab"))
    FileUtils.cp(mobile_aab, File.join(downloads_subfolder, "BioCue-Mobile.aab"))
    UI.message("✓ Copied Mobile AAB to: #{downloads_subfolder}/BioCue-Mobile.aab")
  end

  if wear_apk
    FileUtils.cp(wear_apk, File.join(dest_folder, "BioCue-Wear.apk"))
    FileUtils.cp(wear_apk, File.join(downloads_subfolder, "BioCue-Wear.apk"))
    UI.message("✓ Copied Wear APK to: #{downloads_subfolder}/BioCue-Wear.apk")
  end

  if wear_aab
    FileUtils.cp(wear_aab, File.join(dest_folder, "BioCue-Wear.aab"))
    FileUtils.cp(wear_aab, File.join(downloads_subfolder, "BioCue-Wear.aab"))
    UI.message("✓ Copied Wear AAB to: #{downloads_subfolder}/BioCue-Wear.aab")
  end

  dmg_src = File.join(root_dir, "build/#{app_name}.dmg")
  sha_src = File.join(root_dir, "build/#{app_name}.dmg.sha256")
  app_src = File.join(root_dir, "build/Release/#{app_name}.app")

  if File.exist?(dmg_src)
    FileUtils.cp(dmg_src, dest_folder)
    FileUtils.cp(sha_src, dest_folder) if File.exist?(sha_src)
    FileUtils.cp(dmg_src, downloads_subfolder)
    FileUtils.cp(sha_src, downloads_subfolder) if File.exist?(sha_src)
    UI.message("✓ Copied DMG to: #{downloads_subfolder}/#{app_name}.dmg")
  end

  if Dir.exist?(app_src)
    FileUtils.cp_r(app_src, dest_folder)
    UI.message("✓ Copied #{app_name}.app to: #{dest_folder}/#{app_name}.app")
  end
end

# ==============================================================================
# Platform: macOS
# ==============================================================================
def build_uninstaller_script(app_name: "BioCue", bundle_id: "com.example.app")
  <<~'BASH'
#!/usr/bin/env bash
# ==============================================================================
# Complete Uninstaller & Permission Reset Tool
# ==============================================================================
set -euo pipefail

BUNDLE_ID="__BUNDLE_ID__"
APP_NAME="__APP_NAME__"

BOLD='\033[1m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
YELLOW='\033[0;33m'
RED='\033[0;31m'
NC='\033[0m'

FORCE=false
PERMISSIONS_ONLY=false
KEEP_APP=false
DRY_RUN=false
MENU_REQUESTED=false
FLAGS_PROVIDED=false

while [[ $# -gt 0 ]]; do
    case "$1" in
        -m|--menu)
            MENU_REQUESTED=true
            FLAGS_PROVIDED=true
            shift
            ;;
        -f|--force)
            FORCE=true
            FLAGS_PROVIDED=true
            shift
            ;;
        --permissions-only)
            PERMISSIONS_ONLY=true
            FLAGS_PROVIDED=true
            shift
            ;;
        --keep-app)
            KEEP_APP=true
            FLAGS_PROVIDED=true
            shift
            ;;
        --dry-run)
            DRY_RUN=true
            FLAGS_PROVIDED=true
            shift
            ;;
        -h|--help)
            echo "Usage: $0 [options]"
            echo ""
            echo "Options:"
            echo "  -m, --menu            Display interactive uninstall selection menu"
            echo "  -f, --force           Skip confirmation prompt and perform uninstall immediately"
            echo "  --permissions-only    Only reset macOS Privacy & Security permissions (TCC)"
            echo "  --keep-app            Clean permissions, caches, and preferences, but keep app bundle"
            echo "  --dry-run             List items and permissions that would be removed without modifying anything"
            echo "  -h, --help            Show this help message"
            echo ""
            echo "Target Bundle ID: ${BUNDLE_ID}"
            exit 0
            ;;
        *)
            echo -e "${RED}Unknown option: $1${NC}"
            echo "Run with --help for usage."
            exit 1
            ;;
    esac
done

if [ "$MENU_REQUESTED" = true ] || { [ "$FLAGS_PROVIDED" = false ] && [ -t 0 ]; }; then
    echo -e "${BOLD}${BLUE}====================================================${NC}"
    echo -e "${BOLD}${BLUE}🧹 ${APP_NAME} macOS Uninstaller & Reset Tool${NC}"
    echo -e "${BOLD}${BLUE}====================================================${NC}"
    echo -e "${BOLD}Target Application:${NC} ${APP_NAME}"
    echo -e "  • Bundle ID: ${BOLD}${BUNDLE_ID}${NC}"
    echo ""
    echo -e "${BOLD}Please choose an uninstall option:${NC}"
    echo ""
    echo -e "  ${BOLD}${CYAN}1)${NC} ${BOLD}Complete Uninstall${NC} (Recommended)"
    echo -e "  ${BOLD}${CYAN}2)${NC} ${BOLD}Reset Privacy & Security Permissions only${NC}"
    echo -e "  ${BOLD}${CYAN}3)${NC} ${BOLD}Clean Caches & Preferences only${NC}"
    echo -e "  ${BOLD}${CYAN}4)${NC} ${BOLD}Dry Run (Preview)${NC}"
    echo -e "  ${BOLD}${CYAN}5)${NC} ${BOLD}Cancel & Exit${NC}"
    echo ""
    echo -n "Select an option [1-5] (default: 1): "
    read -r choice || choice="5"
    choice="${choice:-1}"

    case "$choice" in
        1) PERMISSIONS_ONLY=false; KEEP_APP=false; DRY_RUN=false ;;
        2) PERMISSIONS_ONLY=true; KEEP_APP=true; DRY_RUN=false ;;
        3) PERMISSIONS_ONLY=false; KEEP_APP=true; DRY_RUN=false ;;
        4) DRY_RUN=true ;;
        5|[Qq]|[Cc]|"exit")
            echo -e "\n${YELLOW}Operation cancelled by user. No changes made.${NC}"
            exit 0
            ;;
        *)
            echo -e "\n${RED}Invalid option: ${choice}${NC}"
            exit 1
            ;;
    esac
fi

if [ "$DRY_RUN" = true ]; then
    echo -e "\n${YELLOW}🔍 Dry-run mode enabled. No changes will be made.${NC}\n"
fi

if [ "$FORCE" = false ] && [ "$DRY_RUN" = false ]; then
    read -p "Are you sure you want to proceed? [y/N] " -n 1 -r
    echo ""
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        echo -e "${YELLOW}Aborted by user.${NC}"
        exit 0
    fi
fi

# 1. Terminate running instances
if pgrep -x "$APP_NAME" >/dev/null 2>&1; then
    if [ "$DRY_RUN" = false ]; then
        killall "$APP_NAME" 2>/dev/null || true
    fi
fi

# 2. Reset TCC
for svc in All Accessibility ScreenCapture Camera Microphone; do
    if [ "$DRY_RUN" = false ]; then
        tccutil reset "$svc" "$BUNDLE_ID" 2>/dev/null || true
    fi
done

if [ "$PERMISSIONS_ONLY" = true ]; then
    echo -e "${GREEN}✓ Privacy & Security permissions reset for ${BUNDLE_ID}${NC}"
    exit 0
fi

# 3. Defaults & Caches
if [ "$DRY_RUN" = false ]; then
    defaults delete "$BUNDLE_ID" 2>/dev/null || true
    rm -rf "$HOME/Library/Caches/${BUNDLE_ID}" "$HOME/Library/Application Support/${APP_NAME}" 2>/dev/null || true
fi

# 4. Remove App
if [ "$KEEP_APP" = false ] && [ "$DRY_RUN" = false ]; then
    rm -rf "/Applications/${APP_NAME}.app" "$HOME/Applications/${APP_NAME}.app" 2>/dev/null || true
fi

echo -e "${BOLD}${GREEN}🎉 Complete uninstall and permission reset finished successfully!${NC}"
BASH
    .gsub("__BUNDLE_ID__", bundle_id)
    .gsub("__APP_NAME__", app_name)
end

def build_mac_dmg(notarize: false)
  UI.header("🖥️  macOS: Compiling BioCue Release App & DMG")

  build_dir = File.join(root_dir, "build")
  release_dir = File.join(build_dir, "Release")
  archive_path = File.join(build_dir, "BioCue.xcarchive")
  app_path = File.join(release_dir, "BioCue.app")
  dmg_path = File.join(build_dir, "BioCue.dmg")
  sha_path = File.join(build_dir, "BioCue.dmg.sha256")
  bundle_id = ENV["MAC_BUNDLE_ID"] || "com.example.app"

  FileUtils.mkdir_p(release_dir)
  sign_identity = ENV["CODE_SIGN_IDENTITY"] || "-"

  FileUtils.rm_rf(archive_path)
  sh(<<~BASH)
    set -euo pipefail
    xcodebuild archive \
      -project '#{File.join(root_dir, xcode_project)}' \
      -scheme '#{ENV['MAC_SCHEME'] || 'Host'}' \
      -destination 'generic/platform=macOS' \
      -archivePath '#{archive_path}' \
      -configuration Release \
      CODE_SIGN_IDENTITY='#{sign_identity}' \
      CODE_SIGNING_REQUIRED=NO \
      CODE_SIGNING_ALLOWED=YES \
      -skipMacroValidation \
      -quiet
  BASH

  archived_app = Dir[File.join(archive_path, "Products/Applications/*.app")].first
  UI.user_error!("No application bundle found in archive") unless archived_app
  FileUtils.rm_rf(app_path)
  FileUtils.cp_r(archived_app, app_path)

  # Embed uninstaller script into Resources
  resources_dir = File.join(app_path, "Contents/Resources")
  FileUtils.mkdir_p(resources_dir)
  File.write(File.join(resources_dir, "uninstall.command"), build_uninstaller_script(app_name: "BioCue", bundle_id: bundle_id))
  FileUtils.chmod("+x", File.join(resources_dir, "uninstall.command"))

  # Sign
  sh("codesign --force --sign '#{sign_identity}' '#{app_path}'")

  # Package DMG
  dmg_staging = File.join(build_dir, "dmg_staging")
  FileUtils.rm_rf(dmg_staging)
  FileUtils.rm_rf(dmg_path)
  FileUtils.rm_rf(sha_path)
  FileUtils.mkdir_p(dmg_staging)

  FileUtils.cp_r(app_path, dmg_staging)
  FileUtils.ln_s("/Applications", File.join(dmg_staging, "Applications"))

  # Package Uninstaller .app inside DMG
  uninstaller_app = File.join(dmg_staging, "Uninstall BioCue.app")
  uninstaller_macos = File.join(uninstaller_app, "Contents/MacOS")
  uninstaller_res = File.join(uninstaller_app, "Contents/Resources")
  FileUtils.mkdir_p(uninstaller_macos)
  FileUtils.mkdir_p(uninstaller_res)

  File.write(File.join(uninstaller_macos, "Uninstall BioCue"), <<~SH)
    #!/usr/bin/env bash
    SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
    RESOURCES_DIR="$(cd "${SCRIPT_DIR}/../Resources" && pwd)"
    if [ -f "${RESOURCES_DIR}/uninstall.command" ]; then
        open -a Terminal "${RESOURCES_DIR}/uninstall.command"
    fi
  SH
  FileUtils.chmod("+x", File.join(uninstaller_macos, "Uninstall BioCue"))

  File.write(File.join(uninstaller_res, "uninstall.command"), build_uninstaller_script(app_name: "BioCue", bundle_id: bundle_id))
  FileUtils.chmod("+x", File.join(uninstaller_res, "uninstall.command"))

  sh("codesign --force --sign '#{sign_identity}' '#{uninstaller_app}'")

  sh("hdiutil create -volname 'BioCue' -srcfolder '#{dmg_staging}' -ov -format UDZO '#{dmg_path}' -quiet")
  FileUtils.rm_rf(dmg_staging)

  sha256 = `shasum -a 256 "#{dmg_path}"`.split.first
  File.write(sha_path, "#{sha256}  BioCue.dmg\n")

  if notarize && ENV["KEYCHAIN_PROFILE"]
    sh("xcrun notarytool submit '#{dmg_path}' --keychain-profile '#{ENV['KEYCHAIN_PROFILE']}' --wait")
    sh("xcrun stapler staple '#{dmg_path}'")
  end

  UI.success("🎉 Created #{dmg_path}")
end

platform :mac do
  desc "Build macOS Release App bundle & DMG installer locally into ./build/"
  lane :build do
    build_mac_dmg
  end

  desc "Build and release macOS app into destination folder (e.g. macbook-air-webhost)"
  lane :internal do |options|
    dest = options[:folder] || dest_dir
    UI.header("🖥️  macOS: Building Release into #{dest}")
    runner.execute(:build, :mac)
    copy_artifacts_to_folder(dest)
    UI.success("🎉 macOS BioCue released to: #{dest}")
  end

  desc "Build signed & notarized macOS release for external distribution (DMG + GitHub)"
  lane :external do |options|
    tag = options[:tag] || ENV["RELEASE_TAG"] || "v1.0.0"
    dest = options[:folder] || dest_dir
    UI.header("🖥️  macOS: Building External Release (#{tag})")

    notarize = !ENV["KEYCHAIN_PROFILE"].nil?
    build_mac_dmg(notarize: notarize)
    copy_artifacts_to_folder(dest)

    dmg_path = File.join(root_dir, "build/BioCue.dmg")
    sha_path = File.join(root_dir, "build/BioCue.dmg.sha256")

    if system("command -v gh >/dev/null 2>&1")
      UI.message("🚀 Publishing to GitHub Releases via gh CLI...")
      sh("gh release create '#{tag}' '#{dmg_path}' '#{sha_path}' --title 'BioCue #{tag} (macOS)' --notes 'BioCue macOS Release' 2>/dev/null || gh release upload '#{tag}' '#{dmg_path}' '#{sha_path}' --clobber")
      UI.success("✓ Published #{tag} to GitHub Releases")
    else
      UI.important("gh CLI not installed. Skipping GitHub Release upload. Local DMG is ready at: #{dmg_path}")
    end
  end

  desc "Uninstall BioCue from local Mac: resets TCC permissions and removes app"
  lane :uninstall do
    UI.header("🖥️  macOS: Uninstalling BioCue")
    sh("pkill -f 'BioCue' 2>/dev/null || true")
    bundle_id = ENV["MAC_BUNDLE_ID"] || "com.example.app"
    sh("tccutil reset ScreenCapture #{bundle_id} 2>/dev/null || true")
    sh("tccutil reset Camera #{bundle_id} 2>/dev/null || true")
    sh("tccutil reset Microphone #{bundle_id} 2>/dev/null || true")
    FileUtils.rm_rf("/Applications/BioCue.app")
    UI.success("🎉 BioCue uninstalled cleanly from local Mac")
  end

  desc "Build and submit macOS Host to Mac App Store"
  lane :release_appstore do
    UI.header("🖥️  macOS: Building for Mac App Store")
    api_key = asc_api_key

    build_mac_app(
      project:          xcode_project,
      scheme:           ENV["MAC_SCHEME"] || "MirrorHost",
      configuration:    "Release",
      export_method:    "app-store",
      output_directory: "build/appstore_mac",
      output_name:      "#{app_name}Mac"
    )

    if api_key || ENV["APPLE_ID"]
      upload_to_app_store(
        api_key:          api_key,
        platform:         "osx",
        pkg:              "build/appstore_mac/#{app_name}Mac.pkg",
        skip_metadata:    true,
        skip_screenshots: true
      )
      UI.success("🎉 Mac App Store package uploaded successfully!")
    else
      UI.important("Apple credentials not set in environment. Package generated at build/appstore_mac/#{app_name}Mac.pkg")
    end
  end
end

# ==============================================================================
# Platform: iOS / iPadOS
# ==============================================================================
platform :ios do
  desc "Build iOS client IPA locally into build/ios_internal/"
  lane :build do
    UI.header("📱 iOS: Compiling #{app_name}Client IPA")

    ios_build_dir = File.join(root_dir, "build/ios_internal")
    FileUtils.rm_rf(ios_build_dir)
    FileUtils.mkdir_p(ios_build_dir)

    sh(<<~BASH)
      set -euo pipefail
      xcodebuild -project '#{File.join(root_dir, xcode_project)}' \
        -scheme '#{ENV['IOS_SCHEME'] || 'Client'}' \
        -configuration Release \
        -destination 'generic/platform=iOS' \
        -derivedDataPath '#{ios_build_dir}/derivedData' \
        CODE_SIGNING_ALLOWED=NO \
        CODE_SIGN_IDENTITY="" \
        CODE_SIGNING_REQUIRED=NO \
        -quiet build

      APP_SRC="$(find '#{ios_build_dir}/derivedData' -name '#{app_name}.app' -type d | head -n 1)"
      if [ -n "${APP_SRC}" ]; then
        PAYLOAD_DIR="#{ios_build_dir}/Payload"
        mkdir -p "${PAYLOAD_DIR}"
        cp -R "${APP_SRC}" "${PAYLOAD_DIR}/"
        (cd "#{ios_build_dir}" && zip -qr "#{app_name}Client.ipa" Payload)
      fi
    BASH
    UI.success("🎉 iOS IPA built into build/ios_internal/#{app_name}Client.ipa")
  end

  desc "Build iOS client and export IPA to destination folder for sideloading"
  lane :internal do |options|
    dest = options[:folder] || dest_dir
    UI.header("📱 iOS: Building #{app_name} for Internal Sideload")
    runner.execute(:build, :ios)

    ipa_src = File.join(root_dir, "build/ios_internal/#{app_name}Client.ipa")
    if File.exist?(ipa_src)
      FileUtils.mkdir_p(dest)
      FileUtils.cp(ipa_src, File.join(dest, "#{app_name}Client.ipa"))
      downloads_subfolder = File.join(dest, "downloads")
      if Dir.exist?(downloads_subfolder)
        FileUtils.cp(ipa_src, File.join(downloads_subfolder, "#{app_name}Client.ipa"))
      end
      UI.success("✓ Copied #{app_name}Client.ipa to #{dest}")
    end
  end

  desc "Build and upload iOS client to Apple TestFlight"
  lane :testflight_upload do |options|
    external = options[:external] || false
    UI.header("📱 iOS: Building for TestFlight #{external ? '(External)' : '(Internal)'}")
    api_key = asc_api_key

    build_app(
      project:          xcode_project,
      scheme:           ENV["IOS_SCHEME"] || "Client",
      configuration:    "Release",
      export_method:    "app-store",
      output_directory: "build/ios_testflight",
      output_name:      "#{app_name}Client"
    )

    upload_to_testflight(
      api_key:                           api_key,
      skip_waiting_for_build_processing: true,
      distribute_external:               external
    )
    UI.success("🎉 Uploaded iOS client to TestFlight!")
  end

  desc "Build and submit iOS client to App Store"
  lane :release_appstore do
    UI.header("📱 iOS: Building for App Store")
    api_key = asc_api_key

    build_app(
      project:          xcode_project,
      scheme:           ENV["IOS_SCHEME"] || "Client",
      configuration:    "Release",
      export_method:    "app-store",
      output_directory: "build/ios_appstore",
      output_name:      "#{app_name}Client"
    )

    upload_to_app_store(
      api_key:          api_key,
      platform:         "ios",
      ipa:              "build/ios_appstore/#{app_name}Client.ipa",
      skip_metadata:    true,
      skip_screenshots: true
    )
    UI.success("🎉 iOS client submitted to App Store Connect!")
  end
end

# ==============================================================================
# Platform: Android
# ==============================================================================
# ==============================================================================
# Platform: Android (Native Kotlin, Jetpack Compose, Flutter & Wear OS)
# ==============================================================================
platform :android do
  desc "Build Android release APK & AAB locally"
  lane :build do
    UI.header("🤖 Android: Compiling Release APK & AAB")
    if File.exist?(File.join(root_dir, "pubspec.yaml"))
      sh("flutter build appbundle --release")
      sh("flutter build apk --release")
    elsif File.exist?(File.join(root_dir, "flutter/pubspec.yaml"))
      sh("cd flutter && flutter build appbundle --release")
      sh("cd flutter && flutter build apk --release")
    elsif File.exist?(File.join(root_dir, "android/gradlew"))
      sh("cd '#{File.join(root_dir, "android")}' && ./gradlew bundleRelease assembleRelease")
    elsif File.exist?(File.join(root_dir, "gradlew"))
      sh("cd '#{root_dir}' && ./gradlew bundleRelease assembleRelease")
    else
      UI.user_error!("Neither Flutter nor Gradle build system detected for Android")
    end
    UI.success("🎉 Android APK & AAB compiled successfully!")
  end

  desc "Build Android release APK & AAB and export into destination folder"
  lane :internal do |options|
    dest = options[:folder] || dest_dir
    UI.header("🤖 Android: Building Release into #{dest}")
    runner.execute(:build, :android)
    copy_artifacts_to_folder(dest)
    UI.success("🎉 Android Companion & Wear OS artifacts exported to #{dest}!")
  end

  desc "Build and publish Android release to GitHub and Closed/Open Testing"
  lane :external do |options|
    tag = options[:tag] || ENV["RELEASE_TAG"] || "v1.0.0"
    UI.header("🤖 Android: Building External Release (#{tag})")
    runner.execute(:build, :android)

    apk_candidates = Dir[
      File.join(root_dir, "android/mobile/build/outputs/apk/release/*.apk"),
      File.join(root_dir, "android/app/build/outputs/apk/release/*.apk"),
      File.join(root_dir, "mobile/build/outputs/apk/release/*.apk"),
      File.join(root_dir, "flutter/build/app/outputs/flutter-apk/*.apk"),
      File.join(root_dir, "build/app/outputs/flutter-apk/*.apk")
    ]
    apk_path = apk_candidates.find { |p| File.exist?(p) }

    if apk_path && File.exist?(apk_path) && system("command -v gh >/dev/null 2>&1")
      sh("gh release upload '#{tag}' '#{apk_path}##{app_name}-Android-#{tag}.apk' --clobber 2>/dev/null || true")
      UI.success("✓ Attached Android APK to GitHub release #{tag}")
    end
  end

  desc "Publish production AAB to Google Play Store"
  lane :release_playstore do |options|
    rollout = options[:rollout] || ENV["ROLLOUT_PERCENTAGE"] || "0.10"
    UI.header("🤖 Android: Publishing to Google Play Store (Production, Rollout: #{rollout})")
    runner.execute(:build, :android)

    mobile_aab = Dir[File.join(root_dir, "android/mobile/build/outputs/bundle/release/*.aab")].first
    wear_aab   = Dir[File.join(root_dir, "android/wear/build/outputs/bundle/release/*.aab")].first
    play_json  = resolve_play_json

    unless File.exist?(play_json)
      UI.user_error!("play-account.json not found. Please place service account JSON in project or set SUPPLY_JSON_KEY.")
    end

    metadata_dir = Dir[
      File.join(root_dir, "android/mobile/src/main/play"),
      File.join(root_dir, "android/app/src/main/play"),
      File.join(root_dir, "fastlane/metadata/android")
    ].find { |d| Dir.exist?(d) }

    version_name = app_version

    upload_params = {
      package_name:  ENV["ANDROID_PACKAGE_NAME"] || "com.mtpnda.biocue",
      track:         "production",
      aab:           mobile_aab,
      json_key:      play_json,
      version_name:  version_name,
      metadata_path: metadata_dir,
      skip_upload_apk: true
    }
    upload_params[:rollout] = rollout if rollout && rollout.to_f > 0.0 && rollout.to_f < 1.0

    upload_to_play_store(**upload_params)
    UI.success("🎉 Released #{app_name} Companion to Google Play Production!")

    if wear_aab && File.exist?(wear_aab)
      upload_to_play_store(
        package_name:  ENV["ANDROID_PACKAGE_NAME"] || "com.mtpnda.biocue",
        track:         "wear:production",
        aab:           wear_aab,
        json_key:      play_json,
        version_name:  version_name,
        skip_upload_apk: true,
        skip_upload_metadata: true
      )
      UI.success("🎉 Released #{app_name} Wear OS to Google Play Production!")
    end
  end

  desc "Upload AAB to Google Play Internal Testing track"
  lane :release_playstore_internal do
    UI.header("🤖 Android: Uploading to Google Play Internal Testing")
    runner.execute(:build, :android)

    mobile_aab = Dir[File.join(root_dir, "android/mobile/build/outputs/bundle/release/*.aab")].first
    wear_aab   = Dir[File.join(root_dir, "android/wear/build/outputs/bundle/release/*.aab")].first
    play_json  = resolve_play_json

    unless File.exist?(play_json)
      UI.user_error!("play-account.json not found. Please place service account JSON in project or set SUPPLY_JSON_KEY.")
    end

    version_name = app_version

    if mobile_aab && File.exist?(mobile_aab)
      UI.message("📱 Uploading Phone Companion AAB to Google Play Internal track...")
      upload_to_play_store(
        package_name:  ENV["ANDROID_PACKAGE_NAME"] || "com.mtpnda.biocue",
        track:         "internal",
        aab:           mobile_aab,
        json_key:      play_json,
        version_name:  version_name,
        skip_upload_apk:      true,
        skip_upload_metadata: true,
        skip_upload_images:   true,
        skip_upload_screenshots: true
      )
      UI.success("🎉 Uploaded Companion AAB to Google Play Internal Testing!")
    end

    if wear_aab && File.exist?(wear_aab)
      UI.message("⌚ Uploading Wear OS AAB to Google Play Wear Internal track...")
      upload_to_play_store(
        package_name:  ENV["ANDROID_PACKAGE_NAME"] || "com.mtpnda.biocue",
        track:         "wear:internal",
        aab:           wear_aab,
        json_key:      play_json,
        version_name:  version_name,
        skip_upload_apk:      true,
        skip_upload_metadata: true,
        skip_upload_images:   true,
        skip_upload_screenshots: true
      )
      UI.success("🎉 Uploaded Wear OS AAB to Google Play Internal Testing!")
    end
  end

  desc "Publish Store Listing (text descriptions & graphics) only"
  lane :release_playstore_listing do
    UI.header("🤖 Android: Updating Store Listing on Google Play")
    has_gpp = Dir[File.join(root_dir, "**/*.gradle.kts"), File.join(root_dir, "**/*.gradle")].any? do |f|
      File.read(f).include?("com.github.triplet.play") rescue false
    end

    if has_gpp
      gradle_prefix = if File.exist?(File.join(root_dir, "android/gradlew"))
        "cd '#{File.join(root_dir, "android")}' && ./gradlew"
      elsif File.exist?(File.join(root_dir, "flutter/android/gradlew"))
        "cd '#{File.join(root_dir, "flutter/android")}' && ./gradlew"
      else
        "cd '#{root_dir}' && ./gradlew"
      end
      sh("#{gradle_prefix} publishListing")
      UI.success("🎉 Store Listing updated via GPP!")
    else
      play_json = ENV["SUPPLY_JSON_KEY"] || Dir[
        File.join(root_dir, "play-account.json"),
        File.join(root_dir, "android/play-account.json"),
        File.join(root_dir, "flutter/android/play-account.json")
      ].find { |f| File.exist?(f) }

      metadata_dir = Dir[
        File.join(root_dir, "android/mobile/src/main/play"),
        File.join(root_dir, "android/app/src/main/play"),
        File.join(root_dir, "flutter/android/app/src/main/play"),
        File.join(root_dir, "mobile/src/main/play"),
        File.join(root_dir, "play"),
        File.join(root_dir, "fastlane/metadata/android")
      ].find { |d| Dir.exist?(d) }

      upload_to_play_store(
        package_name:  ENV["ANDROID_PACKAGE_NAME"] || "com.mtpnda.biocue",
        json_key:      play_json,
        metadata_path: metadata_dir,
        skip_upload_aab: true,
        skip_upload_apk: true
      )
      UI.success("🎉 Store Listing updated via Fastlane Supply!")
    end
  end

  desc "Upload Google Play Store metadata (listings, descriptions, graphics) via Fastlane Supply"
  lane :upload_metadata do
    UI.header("🤖 Android: Uploading Store Metadata via Fastlane Supply")
    play_json = ENV["SUPPLY_JSON_KEY"] || Dir[
      File.join(root_dir, "play-account.json"),
      File.join(root_dir, "android/play-account.json"),
      File.join(root_dir, ".secrets/android/play-account.json"),
      File.expand_path("~/.secrets/android/play-account.json")
    ].find { |f| File.exist?(f) }

    supply_dir = File.join(root_dir, "fastlane/metadata_play")
    sync_tool = File.join(root_dir, "misc/tools/sync_play_metadata.py")
    sh("python3 '#{sync_tool}'") if File.exist?(sync_tool)

    upload_to_play_store(
      package_name:           ENV["ANDROID_PACKAGE_NAME"] || "com.mtpnda.biocue",
      json_key:               play_json,
      metadata_path:          supply_dir,
      track:                  "internal",
      skip_upload_apk:        true,
      skip_upload_aab:        true,
      skip_upload_changelogs: true,
      sync_image_upload:      false
    )
    UI.success("🎉 Store metadata & graphics uploaded via Fastlane Supply!")
  end

  desc "Install BioCue Companion APK onto connected Android device or emulator"
  lane :install do |options|
    UI.header("🤖 Android: Installing BioCue Companion onto Device/Emulator")

    adb_bin = ENV["ADB_PATH"] || `which adb 2>/dev/null`.strip
    if adb_bin.empty? || !File.exist?(adb_bin)
      adb_bin = File.expand_path("~/Library/Android/sdk/platform-tools/adb")
    end
    UI.user_error!("adb not found. Please ensure Android SDK platform-tools are installed.") unless File.exist?(adb_bin)

    devices_output = `#{adb_bin} devices 2>/dev/null`
    online_devices = devices_output.scan(/^([^\s]+)\s+device$/).flatten

    if online_devices.empty?
      UI.important("No active Android device detected. Checking for available emulators...")
      avd = options[:avd] || ENV["AVD"] || "Pixel_Tablet"
      emulator_bin = File.expand_path("~/Library/Android/sdk/emulator/emulator")
      if File.exist?(emulator_bin)
        UI.message("🚀 Launching emulator '#{avd}'...")
        pid = Process.spawn("#{emulator_bin} -avd #{avd}", out: "/dev/null", err: "/dev/null", pgroup: true)
        Process.detach(pid)
        system("#{adb_bin} wait-for-device")
        while `#{adb_bin} shell getprop sys.boot_completed 2>/dev/null`.strip != "1"
          sleep 2
        end
        devices_output = `#{adb_bin} devices 2>/dev/null`
        online_devices = devices_output.scan(/^([^\s]+)\s+device$/).flatten
        UI.success("✓ Emulator booted successfully!")
      else
        UI.user_error!("No connected Android device and emulator binary not found.")
      end
    end

    active_id = options[:device] || ENV["DEVICE"] || online_devices.first
    device_arg = active_id ? "-s #{active_id}" : ""
    UI.message("📱 Target device: #{active_id || 'default'}")

    apk_candidates = Dir[
      File.join(root_dir, "android/mobile/build/outputs/apk/release/*.apk"),
      File.join(root_dir, "android/mobile/build/outputs/apk/debug/*.apk"),
      File.join(root_dir, "mobile/build/outputs/apk/release/*.apk"),
      File.join(root_dir, "mobile/build/outputs/apk/debug/*.apk"),
      File.join(dest_dir, "downloads/BioCue-Mobile.apk"),
      File.join(dest_dir, "downloads/BioCue.apk")
    ]
    apk_path = apk_candidates.find { |p| File.exist?(p) }

    if options[:build] || apk_path.nil?
      UI.message("Compiling fresh mobile APK...")
      gradle_prefix = File.exist?(File.join(root_dir, "android/gradlew")) ? "cd '#{File.join(root_dir, "android")}' && ./gradlew" : "cd '#{root_dir}' && ./gradlew"
      sh("#{gradle_prefix} :mobile:assembleDebug")
      apk_candidates = Dir[
        File.join(root_dir, "android/mobile/build/outputs/apk/debug/*.apk"),
        File.join(root_dir, "mobile/build/outputs/apk/debug/*.apk")
      ]
      apk_path = apk_candidates.find { |p| File.exist?(p) }
    end

    UI.user_error!("BioCue Mobile APK not found!") unless apk_path && File.exist?(apk_path)

    package_name = "com.mtpnda.biocue"
    UI.message("📲 Installing #{File.basename(apk_path)} onto #{active_id}...")
    install_cmd = "#{adb_bin} #{device_arg} install -r -d '#{apk_path}'"
    install_out = `#{install_cmd} 2>&1`

    if install_out.include?("INSTALL_FAILED_UPDATE_INCOMPATIBLE")
      UI.important("Detected signature mismatch with existing installed version. Reinstalling cleanly...")
      system("#{adb_bin} #{device_arg} uninstall #{package_name} >/dev/null 2>&1 || true")
      install_out = `#{install_cmd} 2>&1`
    end

    unless install_out.include?("Success")
      UI.user_error!("Failed to install APK onto device: #{install_out.strip}")
    end

    UI.success("✓ Installed BioCue Companion APK successfully!")

    if options[:launch] != false
      UI.message("🚀 Launching #{package_name}...")
      system("#{adb_bin} #{device_arg} shell monkey -p #{package_name} -c android.intent.category.LAUNCHER 1 >/dev/null 2>&1 || true")
      UI.success("🎉 BioCue Companion launched on #{active_id}!")
    end
  end

  desc "Install BioCue Wear OS APK onto connected Wear OS device or emulator"
  lane :install_wear do |options|
    UI.header("⌚ Wear OS: Installing BioCue Wear onto Device/Emulator")

    adb_bin = ENV["ADB_PATH"] || `which adb 2>/dev/null`.strip
    if adb_bin.empty? || !File.exist?(adb_bin)
      adb_bin = File.expand_path("~/Library/Android/sdk/platform-tools/adb")
    end
    UI.user_error!("adb not found. Please ensure Android SDK platform-tools are installed.") unless File.exist?(adb_bin)

    devices_output = `#{adb_bin} devices 2>/dev/null`
    online_devices = devices_output.scan(/^([^\s]+)\s+device$/).flatten
    UI.user_error!("No active Android or Wear OS device detected.") if online_devices.empty?

    active_id = options[:device] || ENV["DEVICE"] || online_devices.first
    device_arg = active_id ? "-s #{active_id}" : ""
    UI.message("⌚ Target device: #{active_id || 'default'}")

    apk_candidates = Dir[
      File.join(root_dir, "android/wear/build/outputs/apk/release/*.apk"),
      File.join(root_dir, "android/wear/build/outputs/apk/debug/*.apk"),
      File.join(root_dir, "wear/build/outputs/apk/release/*.apk"),
      File.join(root_dir, "wear/build/outputs/apk/debug/*.apk"),
      File.join(dest_dir, "downloads/BioCue-Wear.apk")
    ]
    apk_path = apk_candidates.find { |p| File.exist?(p) }

    if options[:build] || apk_path.nil?
      UI.message("Compiling fresh wear APK...")
      gradle_prefix = File.exist?(File.join(root_dir, "android/gradlew")) ? "cd '#{File.join(root_dir, "android")}' && ./gradlew" : "cd '#{root_dir}' && ./gradlew"
      sh("#{gradle_prefix} :wear:assembleDebug")
      apk_candidates = Dir[
        File.join(root_dir, "android/wear/build/outputs/apk/debug/*.apk"),
        File.join(root_dir, "wear/build/outputs/apk/debug/*.apk")
      ]
      apk_path = apk_candidates.find { |p| File.exist?(p) }
    end

    UI.user_error!("BioCue Wear APK not found!") unless apk_path && File.exist?(apk_path)

    package_name = "com.mtpnda.biocue"
    UI.message("📲 Installing #{File.basename(apk_path)} onto #{active_id}...")
    install_cmd = "#{adb_bin} #{device_arg} install -r -d '#{apk_path}'"
    install_out = `#{install_cmd} 2>&1`

    if install_out.include?("INSTALL_FAILED_UPDATE_INCOMPATIBLE")
      UI.important("Detected signature mismatch with existing installed version. Reinstalling cleanly...")
      system("#{adb_bin} #{device_arg} uninstall #{package_name} >/dev/null 2>&1 || true")
      install_out = `#{install_cmd} 2>&1`
    end

    unless install_out.include?("Success")
      UI.user_error!("Failed to install Wear APK onto device: #{install_out.strip}")
    end

    UI.success("✓ Installed BioCue Wear OS APK successfully!")

    if options[:launch] != false
      UI.message("🚀 Launching Wear app on #{active_id}...")
      system("#{adb_bin} #{device_arg} shell monkey -p #{package_name} -c android.intent.category.LAUNCHER 1 >/dev/null 2>&1 || true")
      UI.success("🎉 BioCue Wear OS launched on #{active_id}!")
    end
  end
end

# ==============================================================================
# Top-Level Orchestration Lanes (Run via `fastlane <lane>`)
# Grounded multiplatform orchestration using native Fastlane runner dispatch
# ==============================================================================
desc "Install BioCue Companion APK to connected device/emulator"
lane :install do |options|
  runner.execute(:install, :android, options)
end

desc "Install BioCue Wear OS APK to connected watch/emulator"
lane :install_wear do |options|
  runner.execute(:install_wear, :android, options)
end
desc "Build all present platforms locally into ./build/ and ./android/"
lane :build_all do
  UI.header("🔨 Building All Present Platforms")
  has_mac = File.exist?(File.join(root_dir, "apple/project.yml")) || Dir[File.join(root_dir, "**/*.xcodeproj")].any?
  has_ios = Dir[File.join(root_dir, "**/*.xcodeproj")].any? || File.exist?(File.join(root_dir, "ios/Podfile")) || File.exist?(File.join(root_dir, "flutter/ios/Podfile"))
  has_android = Dir.exist?(File.join(root_dir, "android")) || Dir.exist?(File.join(root_dir, "flutter/android")) || Dir.exist?(File.join(root_dir, "mobile")) || File.exist?(File.join(root_dir, "settings.gradle.kts"))

  runner.execute(:build, :mac) if has_mac
  runner.execute(:build, :ios) if has_ios
  runner.execute(:build, :android) if has_android
  UI.success("🎉 All present platform binaries compiled!")
end

desc "Full internal release: Build present platforms and output to destination folder (macbook-air-webhost)"
lane :internal_release do |options|
  dest = options[:folder] || dest_dir
  UI.header("🚀🚀🚀 Starting Full Internal Release Pipeline -> #{dest}")
  has_mac = File.exist?(File.join(root_dir, "apple/project.yml")) || Dir[File.join(root_dir, "**/*.xcodeproj")].any?
  has_ios = Dir[File.join(root_dir, "**/*.xcodeproj")].any? || File.exist?(File.join(root_dir, "ios/Podfile")) || File.exist?(File.join(root_dir, "flutter/ios/Podfile"))
  has_android = Dir.exist?(File.join(root_dir, "android")) || Dir.exist?(File.join(root_dir, "flutter/android")) || Dir.exist?(File.join(root_dir, "mobile")) || File.exist?(File.join(root_dir, "settings.gradle.kts"))

  runner.execute(:internal, :mac, { folder: dest }) if has_mac
  runner.execute(:internal, :ios, { folder: dest }) if has_ios
  runner.execute(:internal, :android, { folder: dest }) if has_android
  UI.success("🎉 All internal releases deployed successfully to #{dest}!")
end

desc "Full external release: Publish macOS DMG, Android APK to GitHub Releases & TestFlight"
lane :external_release do |options|
  UI.header("🚀🚀🚀 Starting Full External Release Pipeline")
  has_mac = File.exist?(File.join(root_dir, "apple/project.yml")) || Dir[File.join(root_dir, "**/*.xcodeproj")].any?
  has_android = Dir.exist?(File.join(root_dir, "android")) || Dir.exist?(File.join(root_dir, "flutter/android")) || Dir.exist?(File.join(root_dir, "mobile")) || File.exist?(File.join(root_dir, "settings.gradle.kts"))

  runner.execute(:external, :mac, options) if has_mac
  runner.execute(:external, :android, options) if has_android
  UI.success("🎉 All external releases published!")
end

desc "Submit all Apple targets (macOS Host & iOS Client) to App Store Connect"
lane :appstore_release do
  UI.header("🍎🍎🍎 Submitting to Apple App Store & Mac App Store")
  has_mac = File.exist?(File.join(root_dir, "apple/project.yml")) || Dir[File.join(root_dir, "**/*.xcodeproj")].any?
  has_ios = Dir[File.join(root_dir, "**/*.xcodeproj")].any? || File.exist?(File.join(root_dir, "ios/Podfile")) || File.exist?(File.join(root_dir, "flutter/ios/Podfile"))

  runner.execute(:release_appstore, :mac) if has_mac
  runner.execute(:release_appstore, :ios) if has_ios
  UI.success("🎉 Apple store submissions initiated!")
end

desc "Publish to Google Play Store Production track"
lane :playstore_release do |options|
  UI.header("🤖🤖🤖 Publishing to Google Play Store")
  runner.execute(:release_playstore, :android, options)
end

desc "Sync store metadata across platforms without building binaries"
lane :metadata do
  UI.header("📋 Syncing Store Metadata Across Platforms")
  runner.execute(:upload_metadata, :android) rescue nil
  UI.success("🎉 Store listings synced successfully!")
end

desc "Deploy current local build artifacts directly to a destination folder"
lane :copy_to_folder do |options|
  dest = options[:folder] || dest_dir
  UI.header("🌐 Copying existing build artifacts to #{dest}")
  copy_artifacts_to_folder(dest)
  UI.success("🎉 Copied build artifacts to #{dest}")
end
